UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if not IS_DESKTOP then return end
	if input.KeyCode == Enum.KeyCode.K then
		setPanelVisible(not panel.Visible)
	end
end)

--==================================================================
--  每帧更新
--==================================================================
local lastCount = -1
local function countEnabled()
	local n = 0
	for _, v in pairs(State) do if v == true then n += 1 end end
	return n
end

RunService.Heartbeat:Connect(function()
	if logoDot.Parent then
		local a = (math.sin(os.clock() * 2.2) + 1) / 2
		logoDot.BackgroundColor3 = Theme.AccentDeep:Lerp(Theme.Accent, a * 0.85)
	end

	local n = countEnabled()
	if n ~= lastCount then
		lastCount = n
		featureCountLbl.Text = "已启用 " .. n .. " 项"
		featureCountLbl.TextColor3 = n > 0 and Theme.Accent or Theme.TextMute
	end

	local root = getRoot()
	if not root then return end

	if State.Fly and flyLV and flyAO then
		local dir = getMoveDir(true)
		flyLV.VectorVelocity = dir.Magnitude > 0.01
			and dir.Unit * Config.FlySpeed or Vector3.zero
		local flat = getFlatLook(root)
		flyAO.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
	end

	if State.Ghost and ghostLV and ghostAO then
		local dir = getMoveDir(false)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { LP.Character }
		local hit = Workspace:Raycast(root.Position, Vector3.new(0, -1000, 0), params)
		local targetY = hit and (hit.Position.Y + Config.GhostHeight) or root.Position.Y
		local vy = math.clamp((targetY - root.Position.Y) * 14, -120, 120)
		local h = dir.Magnitude > 0.01 and dir.Unit * Config.GhostSpeed or Vector3.zero
		ghostLV.VectorVelocity = Vector3.new(h.X, vy, h.Z)
		local flat = getFlatLook(root)
		ghostAO.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
	end
end)

