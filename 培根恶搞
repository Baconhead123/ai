-- ===== 崩服逻辑（一次性装备背包中所有物品，再全部卸下，循环执行） =====
local crashLooping = false   -- 默认不开启
local crashRunning = false   -- 防止重复启动循环

-- 判断是否为可装备物品
local function isEquippable(item)
    return item:IsA("Tool") or item:IsA("HopperBin")
end

-- 一次性装备背包里的所有物品（直接改 Parent，可绕过单工具限制）
local function equipAll()
    local character = localPlayer.Character
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return end
    for _, item in ipairs(backpack:GetChildren()) do
        if isEquippable(item) then
            pcall(function()
                item.Parent = character
            end)
        end
    end
end

-- 一次性卸下角色身上的所有物品（放回背包）
local function unequipAll()
    local character = localPlayer.Character
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return end
    for _, item in ipairs(character:GetChildren()) do
        if isEquippable(item) then
            pcall(function()
                item.Parent = backpack
            end)
        end
    end
    -- 保险：若 Humanoid 上还挂着工具，也一并卸下
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        pcall(function()
            humanoid:UnequipTools()
        end)
    end
end

-- 崩服主循环
local function crashLoop()
    crashRunning = true
    while crashLooping do
        equipAll()
        task.wait(0.001)   -- 全部装备后的停留时间（0.001 秒）
        if not crashLooping then break end
        unequipAll()
        task.wait(0.001)   -- 全部卸下后的停留时间（0.001 秒）
    end
    unequipAll()           -- 退出时确保干净状态
    crashRunning = false
end

-- 崩服按钮点击切换
crashButton.MouseButton1Click:Connect(function()
    if crashLooping then
        -- 关闭崩服
        crashLooping = false
        crashButton.Text = "💥 崩服"
        statusLabel.Text = "状态: 崩服已关闭"
    else
        -- 开启崩服
        crashLooping = true
        crashButton.Text = "⏹️ 停止崩服"
        statusLabel.Text = "状态: 崩服中..."
        if not crashRunning then
            task.spawn(crashLoop)
        end
    end
end)

-- 附身功能
local function startAttaching()
    if connection then
        connection:Disconnect()
        connection = nil
    end
    
    if not targetPlayer then
        statusLabel.Text = "状态: 错误 - 请先选择玩家"
        return
    end
    
    statusLabel.Text = "状态: 附身中 - " .. currentMode
    
    connection = RunService.Heartbeat:Connect(function()
        local localChar = localPlayer.Character
        local targetChar = targetPlayer.Character
        
        if not localChar or not targetChar then 
            statusLabel.Text = "状态: 错误 - 角色不存在"
            return 
        end
        
        if not localChar:FindFirstChild("HumanoidRootPart") or not targetChar:FindFirstChild("HumanoidRootPart") then 
            statusLabel.Text = "状态: 错误 - 缺少HumanoidRootPart"
            return 
        end
        
        local localHRP = localChar.HumanoidRootPart
        local targetHRP = targetChar.HumanoidRootPart
        
        if currentMode == "骑在头上" then
            localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 3, 0)
        elseif currentMode == "头上旋转" then
            local angle = tick() * 3
            local offset = CFrame.new(math.sin(angle) * 2, 3, math.cos(angle) * 2)
            localHRP.CFrame = targetHRP.CFrame * offset
        elseif currentMode == "背在后面" then
            localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -2)
        elseif currentMode == "玩家重合" then
            localHRP.CFrame = targetHRP.CFrame
        elseif currentMode == "背后浮动" then
            floatOffset = floatOffset + floatDirection * 0.1
            if floatOffset > 2 then floatDirection = -1 end
            if floatOffset < -2 then floatDirection = 1 end
            localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, floatOffset, -2)
        elseif currentMode == "固定身后" then
            localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -3)
        elseif currentMode == "脚下遁地" then
            local belowPos = targetHRP.Position + Vector3.new(0, -3, 0)
            localHRP.CFrame = CFrame.new(belowPos, targetHRP.Position)
        end
    end)
end

-- 停止附身
local function stopAttaching()
    if connection then
        connection:Disconnect()
        connection = nil
    end
    statusLabel.Text = "状态: 已停止附身"
end

