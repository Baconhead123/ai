local highlights = {}

local function clearHighlight(plr)
	local h = highlights[plr]
	if h then h:Destroy() end
	highlights[plr] = nil
end

local function applyHighlight(plr)
	clearHighlight(plr)
	local char = plr.Character
	if not char then return end
	highlights[plr] = new("Highlight", {
		Name = "HackXRay", Adornee = char,
		FillColor = Theme.Accent, OutlineColor = Theme.Accent,
		FillTransparency = 0.72, OutlineTransparency = 0.1,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = char,
	})
end

local function refreshXRay()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			if State.XRay then applyHighlight(plr) else clearHighlight(plr) end
		end
	end
end

local function setXRay(on)
	State.XRay = on
	if not on then
		for plr in pairs(highlights) do clearHighlight(plr) end
	end
	refreshXRay()
end

