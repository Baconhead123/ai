            local n = countEnabled()
            if n ~= lastCount then
                lastCount = n
                featureCountLbl.Text = "已启用 " .. n .. " 项"
                featureCountLbl.TextColor3 = n > 0 and Theme.Accent or Theme.TextMute
            end

            local root = getRoot()
            if not root then return end

            if State.Fly and flyLV and flyAO then
                local dir = getMoveDir(true)
                flyLV.VectorVelocity = dir.Magnitude > 0.01
                    and dir.Unit * Config.FlySpeed
                    or Vector3.zero
                local flat = getFlatLook(root)
                flyAO.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
            end

            if State.Ghost and ghostLV and ghostAO then
                local dir = getMoveDir(false)

                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { LP.Character }

                local hit = Workspace:Raycast(root.Position, Vector3.new(0, -1000, 0), params)
                local targetY = hit and (hit.Position.Y + Config.GhostHeight) or root.Position.Y
                local vy = math.clamp((targetY - root.Position.Y) * 14, -120, 120)

                local h = dir.Magnitude > 0.01
                    and dir.Unit * Config.GhostSpeed
                    or Vector3.zero

                ghostLV.VectorVelocity = Vector3.new(h.X, vy, h.Z)
                local flat = getFlatLook(root)
                ghostAO.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
            end
        end)

        --==============================================================
        --  透视同步
        --==============================================================
        Players.PlayerAdded:Connect(function(plr)
            plr.CharacterAdded:Connect(function()
                if not State.XRay then return end
                task.wait(0.4)
                applyHighlight(plr)
            end)
        end)
        Players.PlayerRemoving:Connect(function(plr) clearHighlight(plr) end)

        --==============================================================
        --  重生恢复
        --==============================================================
        LP.CharacterAdded:Connect(function(char)
            char:WaitForChild("Humanoid", 10)
            char:WaitForChild("HumanoidRootPart", 10)
            task.wait(0.3)

            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.UseJumpPower = true
                hum.JumpPower = Config.JumpPower
                if State.SpeedUp then hum.WalkSpeed = Config.WalkSpeed end
            end

            local wasFly   = State.Fly
            local wasGhost = State.Ghost

            if wasFly   then setFly(false)   end
            if wasGhost then setGhost(false) end

            task.wait(0.05)

            if wasFly   then setFly(true)   end
            if wasGhost then setGhost(true) end

            refreshXRay()
            updateMobileControls()
        end)

        --==============================================================
        --  屏幕旋转时刷新缩放
        --==============================================================
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            updateScale()
        end)

        print("[黑客模拟器] 辅助终端 v3.0 已加载 · 平台：" .. (IS_TOUCH and "触屏" or "桌面"))

        statusLabel.Text = "状态: 神秘脚本 v3.0 已启动"
    end)
end)

-- 附身功能
local function startAttaching()
    if connection then
        connection:Disconnect()
        connection = nil
    end
    
    if not targetPlayer then
        statusLabel.Text = "状态: 错误 - 请先选择玩家"
        return
    end
    
    statusLabel.Text = "状态: 附身中 - " .. currentMode
    
    connection = RunService.Heartbeat:Connect(function()
        local localChar = localPlayer.Character
        local targetChar = targetPlayer.Character
        
        if not localChar or not targetChar then 
            statusLabel.Text = "状态: 错误 - 角色不存在"
            return 
        end
        
        if not localChar:FindFirstChild("HumanoidRootPart") or not targetChar:FindFirstChild("HumanoidRootPart") then 
            statusLabel.Text = "状态: 错误 - 缺少HumanoidRootPart"
            return 
        end
        
        local localHRP = localChar.HumanoidRootPart
        local targetHRP = targetChar.HumanoidRootPart
        
        if currentMode == "骑在头上" then
            localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 3, 0)
        elseif currentMode == "头上旋转" then
            local angle = tick() * 3
            local offset = CFrame.new(math.sin(angle) * 2, 3, math.cos(angle) * 2)
            localHRP.CFrame = targetHRP.CFrame * offset
        elseif currentMode == "背在后面" then
            localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -2)
        elseif currentMode == "玩家重合" then
            localHRP.CFrame = targetHRP.CFrame
        elseif currentMode == "背后浮动" then
            floatOffset = floatOffset + floatDirection * 0.1
            if floatOffset > 2 then floatDirection = -1 end
            if floatOffset < -2 then floatDirection = 1 end
            localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, floatOffset, -2)
        elseif currentMode == "固定身后" then
            localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
        elseif currentMode == "脚下遁地" then
            local belowPos = targetHRP.Position + Vector3.new(0, -3, 0)
            localHRP.CFrame = CFrame.new(belowPos, targetHRP.Position)
        end
    end)
end

-- 停止附身
local function stopAttaching()
    if connection then
        connection:Disconnect()
        connection = nil
    end
    statusLabel.Text = "状态: 已停止附身"
end

