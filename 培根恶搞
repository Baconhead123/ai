floatingBtn = new("TextButton", {
	Size = UDim2.fromOffset(IS_TOUCH and 56 or 46, IS_TOUCH and 56 or 46),
	Position = UDim2.new(1, -80, 0.35, 0),
	BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.1,
	BorderSizePixel = 0, Text = "◈", TextColor3 = Theme.Accent,
	Font = Theme.FontBold, TextSize = IS_TOUCH and 24 or 20,
	AutoButtonColor = false, Visible = false, Parent = gui,
})
radius(floatingBtn, IS_TOUCH and 28 or 23)
outline(floatingBtn, Theme.Accent, 2, 0.45)

local fbDragging, fbMoved = false, false
local fbStart, fbOrigin
floatingBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		fbDragging = true; fbMoved = false
		fbStart = input.Position; fbOrigin = floatingBtn.Position
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if not fbDragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		local d = input.Position - fbStart
		if math.abs(d.X) > 6 or math.abs(d.Y) > 6 then fbMoved = true end
		floatingBtn.Position = UDim2.new(
			fbOrigin.X.Scale, fbOrigin.X.Offset + d.X,
			fbOrigin.Y.Scale, fbOrigin.Y.Offset + d.Y)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		fbDragging = false
	end
end)
floatingBtn.MouseButton1Click:Connect(function()
	if fbMoved then return end
	setPanelVisible(true)
end)
if IS_TOUCH then floatingBtn.Visible = true end

