        --  功能：飞行 / 穿墙
        --==============================================================
        local setFly, setGhost

        local flyAtt, flyLV, flyAO
        local ghostAtt, ghostLV, ghostAO

        local function clearFlyObjects()
            if flyLV then flyLV:Destroy() flyLV = nil end
            if flyAO then flyAO:Destroy() flyAO = nil end
            if flyAtt then flyAtt:Destroy() flyAtt = nil end
        end

        local function clearGhostObjects()
            if ghostLV then ghostLV:Destroy() ghostLV = nil end
            if ghostAO then ghostAO:Destroy() ghostAO = nil end
            if ghostAtt then ghostAtt:Destroy() ghostAtt = nil end
        end

        setFly = function(on)
            State.Fly = on
            local hum, root = getHum(), getRoot()
            if not hum or not root then State.Fly = false return end

            if on then
                if State.Ghost then setGhost(false) end
                clearFlyObjects()
                hum.PlatformStand = true
                flyAtt = new("Attachment", { Name = "HackFlyAtt", Parent = root })
                flyLV = new("LinearVelocity", {
                    Attachment0 = flyAtt,
                    RelativeTo = Enum.ActuatorRelativeTo.World,
                    MaxForce = math.huge,
                    VectorVelocity = Vector3.zero,
                    Parent = root,
                })
                flyAO = new("AlignOrientation", {
                    Attachment0 = flyAtt,
                    Mode = Enum.OrientationAlignmentMode.OneAttachment,
                    MaxTorque = math.huge,
                    Responsiveness = 30,
                    Parent = root,
                })
            else
                clearFlyObjects()
                if hum then hum.PlatformStand = false end
            end
        end

        local function setCharCollision(canCollide)
            local c = getChar()
            if not c then return end
            for _, d in ipairs(c:GetDescendants()) do
                if d:IsA("BasePart") then d.CanCollide = canCollide end
            end
        end

        setGhost = function(on)
            State.Ghost = on
            local hum, root = getHum(), getRoot()
            if not hum or not root then State.Ghost = false return end

            if on then
                if State.Fly then setFly(false) end
                clearGhostObjects()
                hum.PlatformStand = true
                setCharCollision(false)
                ghostAtt = new("Attachment", { Name = "HackGhostAtt", Parent = root })
                ghostLV = new("LinearVelocity", {
                    Attachment0 = ghostAtt,
                    RelativeTo = Enum.ActuatorRelativeTo.World,
                    MaxForce = math.huge,
                    Parent = root,
                })
                ghostAO = new("AlignOrientation", {
                    Attachment0 = ghostAtt,
                    Mode = Enum.OrientationAlignmentMode.OneAttachment,
                    MaxTorque = math.huge,
                    Responsiveness = 30,
                    Parent = root,
                })
            else
                clearGhostObjects()
                setCharCollision(true)
                if hum then hum.PlatformStand = false end
            end
        end

