local lightingBackup = {}

local function setFullbright(on)
	State.Fullbright = on
	if on then
		if lightingBackup.Ambient == nil then
			lightingBackup.Ambient        = Lighting.Ambient
			lightingBackup.OutdoorAmbient = Lighting.OutdoorAmbient
			lightingBackup.Brightness     = Lighting.Brightness
			lightingBackup.ClockTime      = Lighting.ClockTime
			lightingBackup.GlobalShadows  = Lighting.GlobalShadows
		end
		Lighting.Ambient        = Color3.fromRGB(178, 178, 178)
		Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
		Lighting.Brightness     = 2
		Lighting.ClockTime      = 14
		Lighting.GlobalShadows  = false
	elseif lightingBackup.Ambient ~= nil then
		Lighting.Ambient        = lightingBackup.Ambient
		Lighting.OutdoorAmbient = lightingBackup.OutdoorAmbient
		Lighting.Brightness     = lightingBackup.Brightness
		Lighting.ClockTime      = lightingBackup.ClockTime
		Lighting.GlobalShadows  = lightingBackup.GlobalShadows
	end
end

local fogBackup = nil

local function setNoFog(on)
	State.NoFog = on
	if on then
		if not fogBackup then
			fogBackup = { FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart, FogColor = Lighting.FogColor }
		end
		Lighting.FogEnd = 100000
		Lighting.FogStart = 100000
	elseif fogBackup then
		Lighting.FogEnd   = fogBackup.FogEnd
		Lighting.FogStart = fogBackup.FogStart
		Lighting.FogColor = fogBackup.FogColor
		fogBackup = nil
	end
end

local nightVisEffect = nil

local function setNightVision(on)
	State.NightVis = on
	if on then
		if not nightVisEffect then
			nightVisEffect = new("ColorCorrectionEffect", {
				Name = "HackNightVision", Brightness = 0.12, Contrast = 0.22,
				Saturation = -0.35, TintColor = Color3.fromRGB(140, 255, 190),
				Parent = Lighting,
			})
		end
	elseif nightVisEffect then
		nightVisEffect:Destroy()
		nightVisEffect = nil
	end
end

