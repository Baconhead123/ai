	radius(knob, knobSize / 2)

	local hit = new("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = track,
	})

	local isOn = not not default

	local function render(animate)
		local info = animate
			and TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			or  TweenInfo.new(0)
		if isOn then
			TweenService:Create(track, info, { BackgroundColor3 = Theme.AccentDeep }):Play()
			TweenService:Create(knob, info, {
				Position = UDim2.new(1, -(knobSize + 3), 0.5, 0),
				BackgroundColor3 = Theme.Accent,
			}):Play()
		else
			TweenService:Create(track, info, { BackgroundColor3 = Theme.Border }):Play()
			TweenService:Create(knob, info, {
				Position = UDim2.new(0, 3, 0.5, 0),
				BackgroundColor3 = Theme.TextDim,
			}):Play()
		end
	end
	render(false)

	hit.MouseButton1Click:Connect(function()
		isOn = not isOn
		render(true)
		if onChange then pcall(onChange, isOn) end
	end)

	return {
		Get = function() return isOn end,
		Set = function(v) if isOn ~= v then isOn = v render(true) end end,
	}
end

local function addSliderRow(parent, order, title, min, max, default, suffix, onChange)
	local row = createBaseRow(parent, order, IS_TOUCH and 72 or 58)
	new("TextLabel", {
		Size = UDim2.new(1, -110, 0, 16), Position = UDim2.new(0, 14, 0, 9),
		BackgroundTransparency = 1, Text = title, TextColor3 = Theme.Text,
		Font = Theme.FontBold, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local valueLbl = new("TextLabel", {
		Size = UDim2.fromOffset(90, 16), Position = UDim2.new(1, -14, 0, 9),
		AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Text = "",
		TextColor3 = Theme.Accent, Font = Theme.FontBold, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
	})
	local track = new("Frame", {
		Size = UDim2.new(1, -28, 0, IS_TOUCH and 8 or 4),
		Position = UDim2.new(0, 14, 0, IS_TOUCH and 48 or 38),
		BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Parent = row,
	})
	radius(track, 4)
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0, Parent = track,
	})
	radius(fill, 4)
	gradient(fill, Theme.AccentBlue, Theme.Accent, 0)

	local knobSize = IS_TOUCH and 22 or 14
	local knob = new("Frame", {
		Size = UDim2.fromOffset(knobSize, knobSize),
		Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(240, 248, 255), BorderSizePixel = 0, Parent = track,
	})
	radius(knob, knobSize / 2)
	outline(knob, Theme.Accent, 2, 0.35)

	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 0, IS_TOUCH and 36 or 26),
		Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1),
		BackgroundTransparency = 1, Text = "", Parent = row,
	})

	local value = default
	local dragging = false

	local function render()
		local s = (max > min) and ((value - min) / (max - min)) or 0
		s = math.clamp(s, 0, 1)
		fill.Size = UDim2.fromScale(s, 1)
		knob.Position = UDim2.new(s, 0, 0.5, 0)
		valueLbl.Text = tostring(value) .. (suffix or "")
	end
	local function applyFromX(x)
		local ax = track.AbsolutePosition.X
		local w = track.AbsoluteSize.X
		if w <= 0 then return end
		local rel = math.clamp((x - ax) / w, 0, 1)
		local nv = math.clamp(math.floor(min + (max - min) * rel + 0.5), min, max)
		if nv ~= value then
			value = nv render()
			if onChange then onChange(value) end
		end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			applyFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			applyFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	render()
	return {
		Get = function() return value end,
		Set = function(v) value = math.clamp(math.floor(v + 0.5), min, max) render() end,
	}
end

