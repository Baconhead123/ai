local joystickFrame, joystickKnob, upBtn, downBtn

local function createMobileJoystick()
	if not IS_TOUCH then return end

	local JS_SIZE = 138
	local KNOB_SZ = 58
	local MAX_R   = JS_SIZE / 2 - KNOB_SZ / 2 - 4

	joystickFrame = new("Frame", {
		Name = "VirtualStick",
		Size = UDim2.fromOffset(JS_SIZE, JS_SIZE),
		Position = UDim2.new(0, 40, 1, -190),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.35,
		BorderSizePixel = 0, Visible = false, Active = true, Parent = gui,
	})
	radius(joystickFrame, JS_SIZE / 2)
	outline(joystickFrame, Theme.Accent, 2, 0.45)

	new("Frame", {
		Size = UDim2.fromOffset(2, 28), Position = UDim2.new(0.5, -1, 0, 14),
		BackgroundColor3 = Theme.Border, BackgroundTransparency = 0.3,
		BorderSizePixel = 0, Parent = joystickFrame,
	})
	new("Frame", {
		Size = UDim2.fromOffset(28, 2), Position = UDim2.new(0, 14, 0.5, -1),
		BackgroundColor3 = Theme.Border, BackgroundTransparency = 0.3,
		BorderSizePixel = 0, Parent = joystickFrame,
	})

	joystickKnob = new("Frame", {
		Size = UDim2.fromOffset(KNOB_SZ, KNOB_SZ),
		Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.15,
		BorderSizePixel = 0, Parent = joystickFrame,
	})
	radius(joystickKnob, KNOB_SZ / 2)
	outline(joystickKnob, Color3.fromRGB(255, 255, 255), 2, 0.5)

	local function makeVertBtn(symbol, yOff)
		local b = new("TextButton", {
			Size = UDim2.fromOffset(66, 66),
			Position = UDim2.new(0, 200, 1, yOff),
			AnchorPoint = Vector2.new(0, 1),
			BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.2,
			BorderSizePixel = 0, Text = symbol, TextColor3 = Theme.Accent,
			Font = Theme.FontBold, TextSize = 22, AutoButtonColor = false,
			Visible = false, Parent = gui,
		})
		radius(b, 33)
		outline(b, Theme.Accent, 2, 0.4)
		return b
	end
	upBtn   = makeVertBtn("▲", -118)
	downBtn = makeVertBtn("▼", -44)

	joystickFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			Stick.active = true
			local center = joystickFrame.AbsolutePosition + joystickFrame.AbsoluteSize / 2
			local d = Vector2.new(input.Position.X - center.X, input.Position.Y - center.Y)
			if d.Magnitude > MAX_R then d = d.Unit * MAX_R end
			joystickKnob.Position = UDim2.new(0.5, d.X, 0.5, d.Y)
			Stick.dirX = d.X / MAX_R
			Stick.dirY = d.Y / MAX_R
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not Stick.active then return end
		if input.UserInputType ~= Enum.UserInputType.Touch
		and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local center = joystickFrame.AbsolutePosition + joystickFrame.AbsoluteSize / 2
		local d = Vector2.new(input.Position.X - center.X, input.Position.Y - center.Y)
		if d.Magnitude > MAX_R then d = d.Unit * MAX_R end
		joystickKnob.Position = UDim2.new(0.5, d.X, 0.5, d.Y)
		Stick.dirX = d.X / MAX_R
		Stick.dirY = d.Y / MAX_R
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			Stick.active = false
			Stick.dirX = 0
			Stick.dirY = 0
			tween(joystickKnob, 0.15, { Position = UDim2.new(0.5, 0, 0.5, 0) })
		end
	end)

	upBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			Stick.up = true
			tween(upBtn, 0.1, { BackgroundTransparency = 0 })
		end
	end)
	upBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			Stick.up = false
			tween(upBtn, 0.1, { BackgroundTransparency = 0.2 })
		end
	end)
	downBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			Stick.down = true
			tween(downBtn, 0.1, { BackgroundTransparency = 0 })
		end
	end)
	downBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			Stick.down = false
			tween(downBtn, 0.1, { BackgroundTransparency = 0.2 })
		end
	end)
end
createMobileJoystick()

function updateMobileControls()
	if not IS_TOUCH or not joystickFrame then return end
	local show = State.Fly or State.Ghost
	joystickFrame.Visible = show
	if upBtn   then upBtn.Visible   = show and State.Fly end
	if downBtn then downBtn.Visible = show and State.Fly end
	if not show then
		Stick.active = false
		Stick.dirX = 0
		Stick.dirY = 0
		Stick.up = false
		Stick.down = false
		if joystickKnob then joystickKnob.Position = UDim2.new(0.5, 0, 0.5, 0) end
	end
end

