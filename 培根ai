-- 添加消息到聊天框
local function AddMessage(text, isAI, id)
	local messageTemplate = CreateMessageTemplate(isAI)
	messageTemplate.Name = "Message_" .. (id or #chatHistory + 1)
	
	local bubble = messageTemplate:FindFirstChild("Bubble")
	local messageText = bubble:FindFirstChild("MessageText")
	
	messageText.Text = text
	
	-- 计算消息宽度（限制最大宽度）
	local maxWidth = 280
	local textSize = game:GetService("TextService"):GetTextSize(
		text,
		messageText.TextSize,
		messageText.Font,
		Vector2.new(maxWidth, math.huge)
	)
	
	bubble.Size = UDim2.new(0, math.min(textSize.X + 20, maxWidth), 0, textSize.Y + 16)
	
	-- 如果是AI消息，添加复制和删除功能
	if isAI then
		local copyButton = bubble:FindFirstChild("CopyButton")
		local deleteButton = bubble:FindFirstChild("DeleteButton")
		
		if copyButton then
			copyButton.MouseButton1Click:Connect(function()
				-- 创建临时文本框用于复制
				local tempBox = Instance.new("TextBox")
				tempBox.Text = text
				tempBox.Parent = PlayerGui
				tempBox:CaptureFocus()
				tempBox:SelectAll()
				
				-- 提示复制成功
				local hint = Instance.new("TextLabel")
				hint.Name = "CopyHint"
				hint.Size = UDim2.new(0, 200, 0, 40)
				hint.Position = UDim2.new(0.5, -100, 0.1, 0)
				hint.AnchorPoint = Vector2.new(0.5, 0)
				hint.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
				hint.Text = "已复制到剪贴板"
				hint.TextColor3 = Color3.fromRGB(255, 255, 255)
				hint.Font = Enum.Font.SourceSans
				hint.TextSize = 14
				hint.Parent = PlayerGui
				
				task.wait(0.1)
				tempBox:Destroy()
				
				task.delay(2, function()
					if hint.Parent then
						hint:Destroy()
					end
				end)
			end)
		end
		
		if deleteButton then
			deleteButton.MouseButton1Click:Connect(function()
				messageTemplate:Destroy()
				
				-- 从聊天历史中移除
				for i, msg in ipairs(chatHistory) do
					if msg.id == id then
						table.remove(chatHistory, i)
						break
					end
				end
			end)
		end
	end
	
	messageTemplate.Parent = ChatContainer
	
	-- 滚动到底部
	task.wait()
	ChatContainer.CanvasPosition = Vector2.new(0, ChatContainer.CanvasSize.Y.Offset)
	
	return messageTemplate
end

-- 调用AI API
local function CallAIAPI(userMessage)
	-- 使用玩家的UserId作为API的userid参数
	local userId = tostring(game.Players.LocalPlayer.UserId)
	
	-- 构建请求URL（GET请求）
	local apiUrl = string.format(
		"https://api.suol.cc/v1/ai.php?userid=%s&msg=%s",
		userId,
		HttpService:UrlEncode(userMessage)
	)
	
	local success, response = pcall(function()
		-- 尝试调用API
		return HttpService:GetAsync(apiUrl, true)
	end)
	
	if success then
		-- 尝试解析JSON响应
		local successParse, data = pcall(function()
			return HttpService:JSONDecode(response)
		end)
		
		if successParse then
			if data.code == 200 then
				return data.msg
			else
				return "AI暂时无法回答，请稍后再试。"
			end
		else
			-- 如果不是JSON，尝试提取消息
			local msgStart = string.find(response, '"msg":"')
			if msgStart then
				msgStart = msgStart + 7
				local msgEnd = string.find(response, '"', msgStart)
				if msgEnd then
					return string.sub(response, msgStart, msgEnd - 1)
				end
			end
			return "收到回复，但格式解析失败。"
		end
	else
		-- 处理HTTP请求失败
		local errorMsg = tostring(response)
		
		-- 检查是否是HTTP服务未启用
		if string.find(errorMsg, "Http requests are not enabled") then
			return "错误：请在游戏设置中启用HTTP请求\n(游戏设置 → 安全 → 允许HTTP请求)"
		elseif string.find(errorMsg, "403") or string.find(errorMsg, "blocked") then
			return "网络连接失败，请检查网络设置。"
		else
			return "暂时无法连接AI服务，请稍后再试。"
		end
	end
end

-- 发送消息
local function SendMessage()
	local message = InputBox.Text
	if message == "" or message == "输入消息..." then
		return
	end
	
	-- 添加用户消息
	local userMessageId = #chatHistory + 1
	table.insert(chatHistory, {
		id = userMessageId,
		text = message,
		isAI = false,
		timestamp = os.time()
	})
	
	AddMessage(message, false, userMessageId)
	
	-- 清空输入框
	InputBox.Text = ""
	InputBox.TextColor3 = Color3.fromRGB(50, 50, 50)
	
	-- 添加"正在输入"提示
	local thinkingMsg = AddMessage("正在思考...", true, "thinking")
	
	-- 调用AI API
	task.spawn(function()
		local aiResponse = CallAIAPI(message)
		
		-- 移除"正在输入"提示
		if thinkingMsg and thinkingMsg.Parent then
			thinkingMsg:Destroy()
		end
		
		-- 添加AI回复
		local aiMessageId = #chatHistory + 1
		table.insert(chatHistory, {
			id = aiMessageId,
			text = aiResponse,
			isAI = true,
			timestamp = os.time()
		})
		
		AddMessage(aiResponse, true, aiMessageId)
	end)
end

