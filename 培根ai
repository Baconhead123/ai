-- 显示/隐藏主界面
local function ToggleMainFrame(visible)
	if visible == nil then
		visible = not MainFrame.Visible
	end
	
	if visible then
		MainFrame.Visible = true
		MainFrame.Size = UDim2.new(0, 0, 0, 0)
		
		local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 400, 0, 600)})
		tween:Play()
	else
		local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 0, 0, 0)})
		
		tween.Completed:Connect(function()
			MainFrame.Visible = false
		end)
		tween:Play()
	end
end

