-- 聊天记录模板
local function CreateMessageTemplate(isAI)
	local template = Instance.new("Frame")
	template.Name = "MessageTemplate"
	template.Size = UDim2.new(1, -20, 0, 0)
	template.AutomaticSize = Enum.AutomaticSize.Y
	template.BackgroundTransparency = 1
	template.LayoutOrder = 1
	
	local Bubble = Instance.new("Frame")
	Bubble.Name = "Bubble"
	Bubble.Size = UDim2.new(0, 0, 0, 0)
	Bubble.AutomaticSize = Enum.AutomaticSize.XY
	Bubble.BackgroundColor3 = isAI and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(158, 234, 106)
	Bubble.BorderSizePixel = 0
	
	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	
	local Padding = Instance.new("UIPadding")
	Padding.PaddingLeft = UDim.new(0, 10)
	Padding.PaddingRight = UDim.new(0, 10)
	Padding.PaddingTop = UDim.new(0, 8)
	Padding.PaddingBottom = UDim.new(0, 8)
	
	local MessageText = Instance.new("TextLabel")
	MessageText.Name = "MessageText"
	MessageText.Size = UDim2.new(1, 0, 0, 0)
	MessageText.AutomaticSize = Enum.AutomaticSize.Y
	MessageText.BackgroundTransparency = 1
	MessageText.Text = ""
	MessageText.TextColor3 = Color3.fromRGB(50, 50, 50)
	MessageText.Font = Enum.Font.SourceSans
	MessageText.TextSize = 16
	MessageText.TextWrapped = true
	MessageText.TextXAlignment = Enum.TextXAlignment.Left
	
	-- AI消息添加复制和删除按钮
	if isAI then
		local CopyButton = Instance.new("TextButton")
		CopyButton.Name = "CopyButton"
		CopyButton.Size = UDim2.new(0, 20, 0, 20)
		CopyButton.Position = UDim2.new(1, -25, 1, -25)
		CopyButton.BackgroundTransparency = 1
		CopyButton.Text = "📋"
		CopyButton.TextColor3 = Color3.fromRGB(150, 150, 150)
		CopyButton.TextSize = 14
		CopyButton.Visible = false
		
		local DeleteButton = Instance.new("TextButton")
		DeleteButton.Name = "DeleteButton"
		DeleteButton.Size = UDim2.new(0, 20, 0, 20)
		DeleteButton.Position = UDim2.new(1, -50, 1, -25)
		DeleteButton.BackgroundTransparency = 1
		DeleteButton.Text = "🗑"
		DeleteButton.TextColor3 = Color3.fromRGB(150, 150, 150)
		DeleteButton.TextSize = 14
		DeleteButton.Visible = false
		
		CopyButton.Parent = Bubble
		DeleteButton.Parent = Bubble
		
		-- 悬停显示按钮
		Bubble.MouseEnter:Connect(function()
			CopyButton.Visible = true
			DeleteButton.Visible = true
		end)
		
		Bubble.MouseLeave:Connect(function()
			CopyButton.Visible = false
			DeleteButton.Visible = false
		end)
	end
	
	-- 组装
	Corner.Parent = Bubble
	Padding.Parent = Bubble
	MessageText.Parent = Bubble
	Bubble.Parent = template
	
	if not isAI then
		Bubble.AnchorPoint = Vector2.new(1, 0)
		Bubble.Position = UDim2.new(1, 0, 0, 0)
	end
	
	return template
end

